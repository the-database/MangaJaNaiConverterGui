<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MangaJaNaiConverterGui.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" 
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:hypertext="clr-namespace:HyperText.Avalonia.Controls;assembly=HyperText.Avalonia"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:uip="using:FluentAvalonia.UI.Controls.Primitives"
        WindowStartupLocation="CenterScreen"
        MinWidth="900" MinHeight="600"
        x:Class="MangaJaNaiConverterGui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/logo.ico"
        Title="MangaJaNaiConverterGui">

  <Window.Styles>
    <Style Selector="TabControl[TabStripPlacement=Top]">
      <!-- Override styled behaviour -->
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.border">
      
      <Setter Property="Margin" Value="0,10,0,0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="BorderBrush" Value="#33888888" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Button.active">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor }" />
      <Style Selector="^:pointerover">
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
          <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        </Style>
      </Style>
    </Style>
    <!-- The settings page's collapsible sections: a bold title and a grey one-line summary of its
         settings. -->
    <Style Selector="Expander.section">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0,8,0,0"/>
      <!-- open and close at once: the theme's 0.25 s crossfade made sections feel slow -->
      <Setter Property="ContentTransition" Value="{x:Null}"/>
      <!-- the theme pads 16 all round; less on top, right under the header -->
      <Setter Property="Padding" Value="16,6,16,16"/>
    </Style>
    <Style Selector="Expander.section /template/ ToggleButton#ExpanderHeader">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.summary">
      <Setter Property="Foreground" Value="Gray"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="StackPanel.row">
      <Setter Property="Orientation" Value="Horizontal"/>
    </Style>
    <!-- A setting's label (text, or a CheckBox) followed by a (?) icon; its ToolTip.Tip explains
         the setting when either is hovered. -->
    <Style Selector="ContentControl.hint">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="ToolTip.ShowDelay" Value="200"/>
      <!-- explanations stay readable while settings are disabled during an upscale -->
      <Setter Property="ToolTip.ShowOnDisabled" Value="True"/>
      <Setter Property="ToolTip.Placement" Value="Bottom"/>
      <Setter Property="Template">
        <ControlTemplate>
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <materialIcons:MaterialIcon Kind="QuestionMarkCircle" Opacity="0.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
          </StackPanel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="GridSplitter:pointerover, GridSplitter:pressed">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
    </Style>
    <!-- Dragged narrow, the sidebar shows only icons; the names move to tooltips. -->
    <Style Selector="DockPanel.compact TextBlock.sidebarLabel">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Button.sidebarItem">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="10"/>
      <!-- beside the button, never under the pointer where it would eat the click -->
      <Setter Property="ToolTip.Placement" Value="Right"/>
    </Style>
    <Style Selector="DockPanel.compact Button.sidebarItem">
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="DockPanel.compact StackPanel.sidebarHeader">
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style Selector="DockPanel:not(.compact) Button.sidebarItem">
      <Setter Property="ToolTip.ServiceEnabled" Value="False"/>
    </Style>
  </Window.Styles>
  
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

  <Grid>
    <!-- Main Content -->
    <Grid x:Name="MainGrid" RowDefinitions="*" IsVisible="{Binding !IsExtractingBackend}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" MinWidth="36" MaxWidth="400" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <DockPanel x:Name="Sidebar" Grid.Column="0" Background="#33000000" SizeChanged="SidebarSizeChanged">

        <StackPanel DockPanel.Dock="Bottom">
          <Button Classes="sidebarItem" Classes.active="{Binding ShowAppSettings}" ToolTip.Tip="App Settings" Command="{Binding HandleAppSettingsSelected}">
            <DockPanel>
              <materialIcons:MaterialIcon Kind="Gear" VerticalAlignment="Center" />
              <TextBlock Classes="sidebarLabel" Margin="5,0,5,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="App Settings" />
            </DockPanel>
          </Button>
        </StackPanel>

        <StackPanel>
          <StackPanel Classes="sidebarHeader" Margin="10">
            <TextBlock Classes="sidebarLabel" TextTrimming="CharacterEllipsis" Text="Default Workflows" />
          </StackPanel>

          <Button Classes="sidebarItem" Command="{Binding HandleWorkflowSelected}" CommandParameter="0"
                  ToolTip.Tip="{Binding Workflows[0].WorkflowName}"
                  Classes.active="{Binding Workflows[0].ActiveWorkflow}">
            <DockPanel>
              <materialIcons:MaterialIcon Kind="Book" VerticalAlignment="Center" />
              <TextBlock Classes="sidebarLabel" Margin="5,0,5,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Workflows[0].WorkflowName}" />
            </DockPanel>
          </Button>

          <StackPanel Classes="sidebarHeader" Orientation="Horizontal" Margin="10" ToolTip.Tip="Custom workflows provide convenient access to save and load preset settings for upscaling." ToolTip.ShowDelay="200">
            <TextBlock Classes="sidebarLabel" Margin="0,0,5,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="Custom Workflows" />
            <materialIcons:MaterialIcon Kind="QuestionMarkCircle" VerticalAlignment="Center" Opacity="0.5" />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding CustomWorkflows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:UpscaleWorkflow">
                <Button Classes="sidebarItem" ClickMode="Press" ToolTip.Tip="{Binding WorkflowName}"
                        Classes.active="{Binding ActiveWorkflow}"
                        Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).HandleWorkflowSelected}"
                        CommandParameter="{Binding WorkflowIndex}">
                  <DockPanel>
                    <materialIcons:MaterialIcon Kind="{Binding WorkflowIcon}" VerticalAlignment="Center" />
                    <TextBlock Classes="sidebarLabel" Margin="5,0,5,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding WorkflowName}" />
                  </DockPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

      </DockPanel>

      <!-- drag to resize the sidebar; the width is remembered -->
      <GridSplitter Grid.Column="1" Width="5" Background="Transparent" ResizeDirection="Columns" DragCompleted="SidebarSplitterDragCompleted" />

      <DockPanel IsVisible="{Binding ShowMainForm}" Grid.Column="2">

        <StackPanel DockPanel.Dock="Bottom">
          <StackPanel Orientation="Horizontal">
            <Button Margin="20,10,0,10" FontWeight="Bold" Background="Green" IsEnabled="{Binding UpscaleEnabled}" Command="{Binding RunUpscale}">
              <StackPanel Orientation="Horizontal">
                <materialIcons:MaterialIcon Kind="PlayCircle" />
                <TextBlock Margin="5,0,0,0">Upscale</TextBlock>
              </StackPanel>

            </Button>
            <Button Margin="20,10,0,10" FontWeight="Bold" Background="Red" IsEnabled="{Binding Upscaling}" Command="{Binding CancelUpscale}">
              <StackPanel Orientation="Horizontal">
                <materialIcons:MaterialIcon Kind="StopCircle" />
                <TextBlock Margin="5,0,0,0">Cancel</TextBlock>
              </StackPanel>
            </Button>
          </StackPanel>

          <StackPanel IsVisible="{Binding ShowConsole}" >
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Margin="20,10,0,0" FontWeight="Bold" Text="Console"></TextBlock>
              <ToggleButton DockPanel.Dock="Right" Margin="0,0,20,0" IsChecked="{Binding !ShowConsole}">
                <materialIcons:MaterialIcon Kind="Close" />
              </ToggleButton>
              <Rectangle/>
            </DockPanel>

            <ScrollViewer Margin="0,10,0,0" Background="#111111" Height="450" HorizontalAlignment="Stretch" HorizontalScrollBarVisibility="Auto" Foreground="Gray"  PropertyChanged="ConsoleScrollViewer_PropertyChanged">
              <SelectableTextBlock Margin="20" Text="{Binding ConsoleText}" FontFamily="Consolas" PropertyChanged="ConsoleTextBlock_PropertyChanged" />
            </ScrollViewer>
          </StackPanel>

          <DockPanel Margin="0" Height="30" DockPanel.Dock="Bottom" HorizontalAlignment="Stretch">

            <TextBlock Margin="10,10,10,0" DockPanel.Dock="Left" FontSize="10" Text="{Binding LeftStatus}" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">

              <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowEstimates}">
                <TextBlock TextAlignment="Center" Width="140" FontSize="10" Margin="5,10,10,0" Text="{Binding ElapsedTime, StringFormat={}Elapsed Time: {0}}" />
                <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowArchiveProgressBar}">
                  <TextBlock TextAlignment="Center" Width="220" FontSize="10" Margin="5,10,10,0" Text="{Binding ArchiveEtr, StringFormat=Remaining Time (Current Archive): {0:hh\\:mm\\:ss}}" />
                </StackPanel>
                <TextBlock TextAlignment="Center" Width="180" FontSize="10" Margin="5,10,10,0" Text="{Binding TotalEtr, StringFormat=Remaining Time (Total): {0:hh\\:mm\\:ss}}" />
                <TextBlock TextAlignment="Center" Width="180" FontSize="10" Margin="5,10,10,0" Text="{Binding TotalEta, StringFormat={}Estimated Finish Time: {0}}" />
              </StackPanel>

              <!-- progress within current archive -->
              <ProgressBar  Margin="5,0,0,0" Height="20"
                            Minimum="0"
                            Maximum="{Binding ProgressTotalFilesInCurrentArchive}"
                            Value="{Binding ProgressCurrentFileInArchive}"
                            ProgressTextFormat="{}{0:0} / {3:0} images in current archive"
                            FontSize="10"
                            ShowProgressText="True"
                            MinWidth="50"
                            Width="50"
                            MaxWidth="50"
                            IsVisible="{Binding ShowArchiveProgressBar}" />

              <!-- total progress across all files -->
              <ProgressBar  Margin="5,0,5,0" Height="20"
                            Minimum="0"
                            Maximum="{Binding ProgressTotalFiles}"
                            Value="{Binding ProgressCurrentFile}"
                            ProgressTextFormat="{}{0:0} / {3:0} total files"
                            FontSize="10"
                            MinWidth="50"
                            Width="50"
                            MaxWidth="50"
                            ShowProgressText="True"/>

              <ToggleButton IsChecked="{Binding ShowConsole}" FontSize="10" Margin="5,0,5,0">
                <StackPanel Orientation="Horizontal">
                  <materialIcons:MaterialIcon Kind="Console" VerticalAlignment="Center" />
                  <TextBlock Margin="5,0,5,0" VerticalAlignment="Center">Console</TextBlock>
                </StackPanel>
              </ToggleButton>
            </StackPanel>

            <Rectangle />
          </DockPanel>
        </StackPanel>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <!-- Main Form -->
          <StackPanel Margin="20">
            <Grid>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,10" Grid.Column="0">
                <TextBlock Margin="0,0,5,0" VerticalAlignment="Center">Workflow Name</TextBlock>
                <TextBox Width="500" Margin="0,0,5,0" Text="{Binding CurrentWorkflow.WorkflowName}"/>
              </StackPanel>

              <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right">

                  <Button Margin="10,0,10,0" Click="ImportCurrentWorkflowButtonClick">
                    <StackPanel Orientation="Horizontal">
                      <materialIcons:MaterialIcon Kind="Import" VerticalAlignment="Center" />
                      <TextBlock Margin="10,0,10,0" VerticalAlignment="Center">Import Workflow</TextBlock>
                    </StackPanel>
                  </Button>
                  <Button Margin="10,0,10,0" Click="ExportCurrentWorkflowButtonClick">
                    <StackPanel Orientation="Horizontal">
                      <materialIcons:MaterialIcon Kind="Export" VerticalAlignment="Center" />
                      <TextBlock Margin="10,0,10,0" VerticalAlignment="Center">Export Workflow</TextBlock>
                    </StackPanel>
                  </Button>
                  <Button Margin="10,0,0,0" Click="ResetWorkflow">
                    <StackPanel Orientation="Horizontal">
                      <materialIcons:MaterialIcon Kind="Refresh" VerticalAlignment="Center" />
                      <TextBlock Margin="10,0,10,0" VerticalAlignment="Center">Reset Workflow</TextBlock>
                    </StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>

            </Grid>

            <!-- The sections follow the pipeline: input, upscaling, the model chains that pick the
                 model for each image, output. Collapsed, each shows a one-line summary. -->

            <!-- Input -->
            <Expander Classes="section" IsExpanded="{Binding CurrentWorkflow.InputSectionExpanded}">
              <Expander.Header>
                <Grid ColumnDefinitions="170,*">
                  <TextBlock Classes="sectionTitle" Text="Input" />
                  <TextBlock Grid.Column="1" Classes="summary" Text="{Binding CurrentWorkflow.InputSummary}" />
                </Grid>
              </Expander.Header>
              <TabControl SelectedIndex="{Binding CurrentWorkflow.SelectedTabIndex}" IsEnabled="{Binding !Upscaling}">
                <!-- compact tabs inside the section (the theme's are 48 px tall) -->
                <TabControl.Styles>
                  <Style Selector="TabItem">
                    <Setter Property="MinHeight" Value="40"/>
                    <Setter Property="FontSize" Value="15"/>
                    <Setter Property="Padding" Value="10,0"/>
                  </Style>
                </TabControl.Styles>
                <TabItem VerticalContentAlignment="Center">
                  <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                      <materialIcons:MaterialIcon Kind="File" />
                      <TextBlock Margin="5,0,5,0">Single File Upscale</TextBlock>
                    </StackPanel>
                  </TabItem.Header>
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0">
                    <ContentControl Classes="hint" Content="Input File"
                                    ToolTip.Tip="Path of the image or archive file (such as zip or cbz) to upscale. If an archive file is selected, each image in the archive will be upscaled and saved to a new archive." />
                    <TextBox Grid.Column="1" x:Name="InputFileNameTextBox" Margin="0,0,5,0" Text="{Binding CurrentWorkflow.InputFilePath}" DragDrop.AllowDrop="True" />
                    <Button Grid.Column="2" Content="Select File" Click="OpenInputFileButtonClick" />
                  </Grid>
                </TabItem>
                <TabItem VerticalContentAlignment="Center">
                  <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                      <materialIcons:MaterialIcon Kind="Folder" />
                      <TextBlock Margin="5,0,5,0">Batch Folder Upscale</TextBlock>
                    </StackPanel>
                  </TabItem.Header>
                  <StackPanel Spacing="12" Margin="0,10,0,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <ContentControl Classes="hint" Content="Input Folder"
                                      ToolTip.Tip="Path of the folder to upscale. The folder and all of its subfolders will be scanned and images and/or archives will be upscaled depending on the selection below." />
                      <TextBox Grid.Column="1" x:Name="InputFolderNameTextBox" Margin="0,0,5,0" Text="{Binding CurrentWorkflow.InputFolderPath}" DragDrop.AllowDrop="True" />
                      <Button Grid.Column="2" Content="Select Folder" Click="OpenInputFolderButtonClick" />
                    </Grid>
                    <StackPanel Classes="row">
                      <CheckBox Margin="0,0,10,0" IsChecked="{Binding CurrentWorkflow.UpscaleArchives}">Upscale Archives</CheckBox>
                      <ContentControl Classes="hint"
                                      ToolTip.Tip="Whether to upscale Image files (*.png, *.jpg, *.jpeg, *.webp, *.bmp, *.avif) and/or Archive files (*.zip, *.cbz, *.rar, *.cbr) in the selected Input Folder.">
                        <CheckBox IsChecked="{Binding CurrentWorkflow.UpscaleImages}">Upscale Images</CheckBox>
                      </ContentControl>
                    </StackPanel>
                  </StackPanel>
                </TabItem>
              </TabControl>
            </Expander>

            <!-- Upscaling -->
            <Expander Classes="section" IsExpanded="{Binding CurrentWorkflow.UpscaleSectionExpanded}">
              <Expander.Header>
                <Grid ColumnDefinitions="170,*">
                  <TextBlock Classes="sectionTitle" Text="Upscaling" />
                  <TextBlock Grid.Column="1" Classes="summary" Text="{Binding CurrentWorkflow.UpscaleSummary}" />
                </Grid>
              </Expander.Header>
              <StackPanel Spacing="12" IsEnabled="{Binding !Upscaling}">
                <StackPanel Classes="row">
                  <ContentControl Classes="hint" Content="Upscale Mode">
                    <ToolTip.Tip>
                      <StackPanel Spacing="6">
                        <TextBlock TextWrapping="Wrap" xml:space="preserve"><Bold>Scale</Bold>: All images will be upscaled by the specified scaling factor. For example, a factor of 2x will double the width and height of each image.</TextBlock>
                        <TextBlock TextWrapping="Wrap" xml:space="preserve"><Bold>Width</Bold>: All images will be upscaled to the specified width, while maintaining aspect ratio of the image.</TextBlock>
                        <TextBlock TextWrapping="Wrap" xml:space="preserve"><Bold>Height</Bold>: All images will be upscaled to the specified height, while maintaining aspect ratio of the image.</TextBlock>
                        <TextBlock TextWrapping="Wrap" xml:space="preserve"><Bold>Fit to Display</Bold>: All images will be upscaled to fit exactly within the specified display device.</TextBlock>
                      </StackPanel>
                    </ToolTip.Tip>
                  </ContentControl>
                  <ToggleButton IsChecked="{Binding CurrentWorkflow.ModeScaleSelected}" Content="Scale" Command="{Binding CurrentWorkflow.SetModeScaleSelected}" />
                  <ToggleButton IsChecked="{Binding CurrentWorkflow.ModeWidthSelected}" Content="Width" Command="{Binding CurrentWorkflow.SetModeWidthSelected}" />
                  <ToggleButton IsChecked="{Binding CurrentWorkflow.ModeHeightSelected}" Content="Height" Command="{Binding CurrentWorkflow.SetModeHeightSelected}" />
                  <ToggleButton IsChecked="{Binding CurrentWorkflow.ModeFitToDisplaySelected}" Content="Fit to Display" Command="{Binding CurrentWorkflow.SetModeFitToDisplaySelected}" />
                </StackPanel>

                <StackPanel Classes="row" IsVisible="{Binding CurrentWorkflow.ModeScaleSelected}">
                  <ContentControl Classes="hint" Content="Scale Factor"
                                  ToolTip.Tip="All images will be upscaled by the specified scaling factor. For example, a factor of 2x will double the width and height of each image." />
                  <ToggleButton IsChecked="{Binding CurrentWorkflow.Is1x}" Content="1x" Command="{Binding CurrentWorkflow.SetUpscaleScaleFactor}" CommandParameter="1" />
                  <ToggleButton IsChecked="{Binding CurrentWorkflow.Is2x}" Content="2x" Command="{Binding CurrentWorkflow.SetUpscaleScaleFactor}" CommandParameter="2" />
                  <ToggleButton IsChecked="{Binding CurrentWorkflow.Is3x}" Content="3x" Command="{Binding CurrentWorkflow.SetUpscaleScaleFactor}" CommandParameter="3" />
                  <ToggleButton IsChecked="{Binding CurrentWorkflow.Is4x}" Content="4x" Command="{Binding CurrentWorkflow.SetUpscaleScaleFactor}" CommandParameter="4" />
                </StackPanel>

                <StackPanel Classes="row" IsVisible="{Binding CurrentWorkflow.ModeHeightSelected}">
                  <ContentControl Classes="hint" Content="Output Height"
                                  ToolTip.Tip="All images will be upscaled to this height. For reading on tablets, this can be used to set the image height to the resolution of your tablet's display." />
                  <NumericUpDown Margin="0,0,5,0" Value="{Binding CurrentWorkflow.ResizeHeightAfterUpscale}" AllowSpin="False" ShowButtonSpinner="False" Minimum="1" />
                  <TextBlock>px</TextBlock>
                </StackPanel>
                <StackPanel Classes="row" IsVisible="{Binding CurrentWorkflow.ModeWidthSelected}">
                  <ContentControl Classes="hint" Content="Output Width"
                                  ToolTip.Tip="All images will be upscaled to this width. For reading on tablets, this can be used to set the image width to the resolution of your tablet's display." />
                  <NumericUpDown Margin="0,0,5,0" Value="{Binding CurrentWorkflow.ResizeWidthAfterUpscale}" AllowSpin="False" ShowButtonSpinner="False" Minimum="1" />
                  <TextBlock>px</TextBlock>
                </StackPanel>

                <!--Fit to Device Mode-->
                <StackPanel Spacing="12" IsVisible="{Binding CurrentWorkflow.ModeFitToDisplaySelected}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" MaxWidth="500" />
                    </Grid.ColumnDefinitions>
                    <ContentControl Classes="hint" Content="Tablet Device or Display"
                                    ToolTip.Tip="The name of the tablet or display device. Start typing to show more options." />
                    <AutoCompleteBox Grid.Column="1" Classes="clearButton" HorizontalAlignment="Stretch" AsyncPopulator="{Binding DevicesPopulator}" FilterMode="None" Text="{Binding CurrentWorkflow.DisplayDevice}" Tapped="HandleDevicesTapped" GotFocus="HandleDevicesGotFocus" MinimumPrefixLength="0" />
                  </Grid>
                  <StackPanel Classes="row">
                    <ContentControl Classes="hint" Content="Display Orientation"
                                    ToolTip.Tip="Whether the display will be used in portrait/vertical mode or landscape/horizontal mode." />
                    <ToggleButton IsChecked="{Binding CurrentWorkflow.DisplayPortraitSelected}" Content="Portrait" />
                    <ToggleButton IsChecked="{Binding !CurrentWorkflow.DisplayPortraitSelected}" Content="Landscape" />
                  </StackPanel>
                  <StackPanel Classes="row">
                    <ContentControl Classes="hint" Content="Display Resolution"
                                    ToolTip.Tip="Actual resolution of the selected display with the selected orientation, width × height." />
                    <TextBlock FontFamily="Consolas">
                      <Run Text="{Binding CurrentWorkflow.DisplayDeviceWidth}"/>
                      <Run Text="px" />
                      <Run Text="×" />
                      <Run Text="{Binding CurrentWorkflow.DisplayDeviceHeight}" />
                      <Run Text="px" />
                    </TextBlock>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Expander>

            <!-- Model Chains: which model runs on which image -->
            <Expander Classes="section" IsExpanded="{Binding CurrentWorkflow.ShowAdvancedSettings}">
              <Expander.Header>
                <Grid ColumnDefinitions="170,*">
                  <ContentControl Classes="hint" HorizontalAlignment="Left"
                                  ToolTip.Tip="A chain is a set of conditions and the desired settings to apply when those conditions are met. When upscaling each image, if that image meets the activation conditions of a chain, then that chain's settings are applied to an image. If the image meets the activation conditions of multiple chains, only the settings of the highest matching chain in the list are applied. If the image doesn't meet the activation condition of any chain, then no processing or upscaling is applied to that image.&#013;&#013;The default settings use one upscaling model for color images, IllustrationJaNai, and several different MangaJaNai models for grayscale images. Each MangaJaNai model is optimized to work on images with a different height, ranging from 1200p to 2048p, so the chains are used to select the most suitable MangaJaNai model based on the resolution of the image.">
                    <TextBlock Classes="sectionTitle" Text="Model Chains" />
                  </ContentControl>
                  <TextBlock Grid.Column="1" Classes="summary" Text="{Binding CurrentWorkflow.ChainsSummary}" />
                </Grid>
              </Expander.Header>
              <StackPanel IsEnabled="{Binding !Upscaling}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MaxWidth="500" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ContentControl Classes="hint" Content="Grayscale Detection Threshold"
                                  ToolTip.Tip="The threshold for which an image is considered grayscale. The default value of 12 considers images with slight color as grayscale, because some grayscale images have slight color due to artifacts. Set the threshold to 0 to consider only strictly grayscale images as grayscale, and increase the threshold to consider images with more color as grayscale." />
                  <Slider Grid.Column="1" Value="{Binding CurrentWorkflow.GrayscaleDetectionThreshold}" Minimum="0" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" />
                  <TextBlock Grid.Column="2" Width="40" Margin="10,0,0,0" TextAlignment="Center" Text="{Binding CurrentWorkflow.GrayscaleDetectionThreshold}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding CurrentWorkflow.Chains}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:UpscaleChain">
                      <Border Classes="border" Margin="0,10,0,0">
                        <StackPanel Spacing="12">
                          <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    IsVisible="{Binding !$parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CurrentWorkflow.IsDefaultWorkflow}"
                                    Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).DeleteChain}"
                                    CommandParameter="{Binding}">
                              <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon Kind="MinusCircle" />
                                <TextBlock Margin="5,0,0,0" Text="Remove" />
                              </StackPanel>
                            </Button>
                            <TextBlock FontWeight="Bold" Text="{Binding ChainNumber, StringFormat=Chain {0}}" />
                          </DockPanel>

                          <TextBlock Foreground="Gray" Text="Activation Condition" />
                          <StackPanel Classes="row">
                            <ContentControl Classes="hint" Content="Resolution Range"
                                            ToolTip.Tip="Range of image resolutions to activate this chain. Select a common resolution from the drop down or type a custom resolution. Larger resolutions require more processing power to upscale. A dimension value of 0 means any value for that dimension, for example 0x1250 means any width, and 1250px tall. A maximum resolution of 0x0 means no resolution limit." />
                            <ui:FAComboBox IsEditable="True" Width="120" MaxDropDownHeight="600" Text="{Binding MinResolution, Mode=TwoWay}"
                                           ItemsSource="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CommonResolutions}" />
                            <TextBlock Margin="5,0,0,0">px</TextBlock>
                            <TextBlock Margin="15,0,15,0"> - </TextBlock>
                            <ui:FAComboBox IsEditable="True" Width="120" MaxDropDownHeight="600" Text="{Binding MaxResolution, Mode=TwoWay}"
                                           ItemsSource="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CommonResolutions}" />
                            <TextBlock Margin="5,0,0,0">px</TextBlock>
                          </StackPanel>
                          <StackPanel Classes="row">
                            <ContentControl Classes="hint" Content="Scaling Factor Range"
                                            ToolTip.Tip="Range of necessary scaling factor to activate this chain. A maximum scaling factor of 0 means no maximum limit." />
                            <NumericUpDown Value="{Binding MinScaleFactor}" Minimum="0" Maximum="999" Width="80" AllowSpin="False" ShowButtonSpinner="False" />
                            <TextBlock Margin="5,0,0,0">x</TextBlock>
                            <TextBlock Margin="15,0,15,0"> - </TextBlock>
                            <NumericUpDown Value="{Binding MaxScaleFactor}" Minimum="0" Maximum="999" Width="80" AllowSpin="False" ShowButtonSpinner="False" />
                            <TextBlock Margin="5,0,0,0">x</TextBlock>
                          </StackPanel>
                          <StackPanel Classes="row">
                            <CheckBox Margin="0,0,10,0" IsChecked="{Binding IsColor}">Is Color Image</CheckBox>
                            <ContentControl Classes="hint"
                                            ToolTip.Tip="Whether the image is color and/or grayscale. Images that appear grayscale but have faint color due to JPEG artifacts are still considered grayscale.">
                              <CheckBox IsChecked="{Binding IsGrayscale}">Is Grayscale Image</CheckBox>
                            </ContentControl>
                          </StackPanel>

                          <TextBlock Foreground="Gray" Margin="0,8,0,0" Text="Upscale Settings" />
                          <ContentControl Classes="hint" HorizontalAlignment="Left"
                                          ToolTip.Tip="If checked, automatically increase the contrast of all grayscale images if necessary. For best results with the MangaJaNai grayscale model, this setting is recommend when upscaling images which appear to be faded. This will have no effect on color images or grayscale images with sufficient contrast.">
                            <CheckBox IsChecked="{Binding AutoAdjustLevels}">Auto Adjust Levels on Grayscale Images</CheckBox>
                          </ContentControl>
                          <WrapPanel>
                            <StackPanel Classes="row" Margin="0,0,25,8">
                              <ContentControl Classes="hint" Content="Resize Height Before Upscale"
                                              ToolTip.Tip="Resize each image to this height before upscaling, set to 0 to disable." />
                              <NumericUpDown Value="{Binding ResizeHeightBeforeUpscale}" Minimum="0" AllowSpin="False" ShowButtonSpinner="False" />
                              <TextBlock Margin="5,0,0,0">px</TextBlock>
                            </StackPanel>
                            <StackPanel Classes="row" Margin="0,0,25,8">
                              <ContentControl Classes="hint" Content="Resize Width Before Upscale"
                                              ToolTip.Tip="Resize each image to this width before upscaling, set to 0 to disable." />
                              <NumericUpDown Value="{Binding ResizeWidthBeforeUpscale}" Minimum="0" AllowSpin="False" ShowButtonSpinner="False" />
                              <TextBlock Margin="5,0,0,0">px</TextBlock>
                            </StackPanel>
                            <StackPanel Classes="row" Margin="0,0,25,8">
                              <ContentControl Classes="hint" Content="Resize Factor Before Upscale"
                                              ToolTip.Tip="Resize each image by this factor before upscaling. This setting is ignored if Resize Height Before Upscale is specified." />
                              <NumericUpDown Value="{Binding ResizeFactorBeforeUpscale}" Minimum="0" AllowSpin="False" ShowButtonSpinner="False" />
                              <TextBlock Margin="5,0,0,0">%</TextBlock>
                            </StackPanel>
                          </WrapPanel>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" MaxWidth="500" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentControl Classes="hint" Content="Model"
                                            ToolTip.Tip="The upscaling model to run. To choose from more models, add PyTorch (*.pth) model files to the models directory. Select No Model to skip running any upscaling model for this chain." />
                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding AllModels}" SelectedValue="{Binding ModelFilePath}" />
                            <Button Grid.Column="2" Margin="5,0,0,0" ToolTip.Tip="Open Models Directory" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenModelsDirectory}">
                              <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon Kind="Launch" />
                                <TextBlock Margin="5,0,0,0" Text="Models Folder" />
                              </StackPanel>
                            </Button>
                          </Grid>
                          <StackPanel Classes="row">
                            <ContentControl Classes="hint" Content="Model Tile Size"
                                            ToolTip.Tip="Tile size to use when upscaling images with the selected model. The image is cut into tiles in order to upscale without running into the VRAM limits of your GPU. Larger is better when the GPU has enough VRAM to support it. The auto setting estimates the largest tile size which can be used based on available VRAM and is recommended for most users." />
                            <ui:FAComboBox IsEditable="True" Width="160" MaxDropDownHeight="600" Text="{Binding ModelTileSize, Mode=TwoWay}"
                                           ItemsSource="{Binding TileSizes}" />
                            <TextBlock Margin="5,0,0,0">px</TextBlock>
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Classes="row" Margin="0,10,0,0" IsVisible="{Binding !CurrentWorkflow.IsDefaultWorkflow}">
                  <ContentControl Classes="hint"
                                  ToolTip.Tip="A chain is a set of upscale settings which can be activated based on conditions such as the image resolution and whether the image is color or grayscale. This allows you to specify different upscale models for different types of images.">
                    <Button Command="{Binding AddChain}">
                      <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon Kind="PlusCircle" />
                        <TextBlock Margin="5,0,0,0">Add Chain</TextBlock>
                      </StackPanel>
                    </Button>
                  </ContentControl>
                </StackPanel>
              </StackPanel>
            </Expander>

            <!-- Output -->
            <Expander Classes="section" IsExpanded="{Binding CurrentWorkflow.OutputSectionExpanded}">
              <Expander.Header>
                <Grid ColumnDefinitions="170,*">
                  <TextBlock Classes="sectionTitle" Text="Output" />
                  <TextBlock Grid.Column="1" Classes="summary" Text="{Binding CurrentWorkflow.OutputSummary}" />
                </Grid>
              </Expander.Header>
              <StackPanel Spacing="12" IsEnabled="{Binding !Upscaling}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <ContentControl Classes="hint" Content="Output Folder"
                                  ToolTip.Tip="Path of the folder to save the upscaled image(s) or archive(s)." />
                  <TextBox Grid.Column="1" x:Name="OutputFolderNameTextBox" Classes="clearButton" Margin="0,0,5,0" Text="{Binding CurrentWorkflow.OutputFolderPath}" DragDrop.AllowDrop="True" />
                  <Button Grid.Column="2" Content="Select Folder" Click="OpenOutputFolderButtonClick" />
                </Grid>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MaxWidth="500" />
                  </Grid.ColumnDefinitions>
                  <ContentControl Classes="hint" Content="Output Filename">
                    <ToolTip.Tip>
                      <TextBlock TextWrapping="Wrap">The filename of the upscaled image(s) or archive(s), without the file extension. <Run FontFamily="Consolas">%filename%</Run> is the input filename without extension. Archives will be output with .cbz extension; images will be output with the extension of the image format selected below.</TextBlock>
                    </ToolTip.Tip>
                  </ContentControl>
                  <TextBox Grid.Column="1" Text="{Binding CurrentWorkflow.OutputFilename}" />
                </Grid>

                <ContentControl Classes="hint" HorizontalAlignment="Left"
                                ToolTip.Tip="If unchecked, upscaling will be skipped for files that already exist in the output path. If checked, any files that already exist in the output path will be overwritten without warning. Use with caution.">
                  <CheckBox IsChecked="{Binding CurrentWorkflow.OverwriteExistingFiles}">Allow Files in Output Path to be Overwritten</CheckBox>
                </ContentControl>

                <StackPanel Classes="row">
                  <ContentControl Classes="hint" Content="Output Image Format">
                    <ToolTip.Tip>
                      <StackPanel Spacing="6">
                        <TextBlock TextWrapping="Wrap" xml:space="preserve"><Bold>WebP</Bold>: Modern format recommended for good quality and efficient filesize compression, with good compatibility on modern devices. Supports lossless and lossy compression.</TextBlock>
                        <TextBlock TextWrapping="Wrap" xml:space="preserve"><Bold>AVIF</Bold>: Modern format with better lossy compression efficiency than WebP, but not as widely supported and slower to save and load compared to WebP.</TextBlock>
                        <TextBlock TextWrapping="Wrap" xml:space="preserve"><Bold>PNG</Bold>: Lossless compressed format with excellent compatibility, but worse compression efficiency than WebP and AVIF.</TextBlock>
                        <TextBlock TextWrapping="Wrap" xml:space="preserve"><Bold>JPEG</Bold>: Lossy compressed format with excellent compatibility, but worse compression efficiency than WebP and AVIF.</TextBlock>
                      </StackPanel>
                    </ToolTip.Tip>
                  </ContentControl>
                  <ToggleButton IsChecked="{Binding CurrentWorkflow.WebpSelected}" Content="WebP" Command="{Binding CurrentWorkflow.SetWebpSelected}" />
                  <ToggleButton IsChecked="{Binding CurrentWorkflow.AvifSelected}" Content="AVIF" Command="{Binding CurrentWorkflow.SetAvifSelected}" />
                  <ToggleButton IsChecked="{Binding CurrentWorkflow.PngSelected}" Content="PNG" Command="{Binding CurrentWorkflow.SetPngSelected}" />
                  <ToggleButton IsChecked="{Binding CurrentWorkflow.JpegSelected}" Content="JPEG" Command="{Binding CurrentWorkflow.SetJpegSelected}" />
                </StackPanel>

                <ContentControl Classes="hint" HorizontalAlignment="Left" IsVisible="{Binding CurrentWorkflow.ShowUseLosslessCompression}"
                                ToolTip.Tip="Use lossless compression. Usually not recommended due to producing images with much larger filesize with little visual benefit.">
                  <CheckBox IsChecked="{Binding CurrentWorkflow.UseLosslessCompression}">Use Lossless Compression</CheckBox>
                </ContentControl>

                <StackPanel Classes="row" IsVisible="{Binding CurrentWorkflow.ShowLossyCompressionQuality}">
                  <ContentControl Classes="hint" Content="Lossy Compression Quality"
                                  ToolTip.Tip="Quality level for compression. Note that a quality level of 100 is still lossy." />
                  <NumericUpDown Margin="0,0,5,0" Value="{Binding CurrentWorkflow.LossyCompressionQuality}" Increment="1" Minimum="0" Maximum="100" Width="120" />
                  <TextBlock>%</TextBlock>
                </StackPanel>
              </StackPanel>
            </Expander>

          </StackPanel>
        </ScrollViewer>

      </DockPanel>


      <!-- Settings Overlay -->
      <ScrollViewer IsVisible="{Binding ShowAppSettings}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,0,30" Grid.Column="2">
      <StackPanel >
        <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="20">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" FontWeight="Bold" Text="App Settings"></TextBlock>
          </DockPanel>

          <!-- App Settings -->
          <Border Classes="border">
            <StackPanel>
              <StackPanel IsVisible="{Binding IsInstalled}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="10,10,0,10">
                    <CheckBox IsChecked="{Binding AutoUpdateEnabled}">Auto Update</CheckBox>
                    <TextBlock Foreground="Gray" FontSize="12" VerticalAlignment="Center" Margin="20,0,0,0" TextWrapping="Wrap">
                      Download updates in the background and install them when MangaJaNaiConverterGui is closed. Updates are always checked for and shown here.
                    </TextBlock>
                  </StackPanel>

                  <StackPanel Orientation="Horizontal" Margin="10,10,0,10">
                    <TextBlock Text="Current Version" VerticalAlignment="Center"></TextBlock>
                    <TextBlock VerticalAlignment="Center" FontFamily="Consolas" Text="{Binding AppVersion}" Margin="20,0,0,0"></TextBlock>
                    <hypertext:Hyperlink VerticalAlignment="Center" Margin="20,0,0,0" Url="https://github.com/the-database/MangaJaNaiConverterGui/releases"/>
                  </StackPanel>

                  <TextBlock Margin="10,10,0,10" TextWrapping="Wrap" Text="{Binding UpdateStatusText}" />

                  <StackPanel Orientation="Horizontal" Margin="10,10,0,10" IsVisible="{Binding ShowCheckUpdateButton}">
                    <Button Command="{Binding CheckForUpdates}">Check for Updates Now</Button>
                  </StackPanel>

                  <StackPanel Orientation="Horizontal" Margin="10,10,0,10" IsVisible="{Binding ShowApplyButton}">
                    <Button Command="{Binding ApplyUpdate}" IsEnabled="{Binding !Upscaling}" ToolTip.Tip="Not available while upscaling." ToolTip.ShowOnDisabled="True">Restart to Update MangaJaNaiConverterGui</Button>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
              <StackPanel IsVisible="{Binding !IsInstalled}">
                <StackPanel Orientation="Horizontal" Margin="10,10,0,10">
                  <TextBlock>App is not installed; auto update settings unavailable.</TextBlock>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Upscale Settings -->
          <DockPanel Margin="0,10,0,0">
            <TextBlock DockPanel.Dock="Left" FontWeight="Bold" Text="Upscale Settings"></TextBlock>
          </DockPanel>
          <Border Classes="border">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="10,10,0,10">
                <TextBlock Margin="0,0,5,0" VerticalAlignment="Center">Device</TextBlock>
                <ComboBox ItemsSource="{Binding DeviceList}" SelectedIndex="{Binding SelectedDeviceIndex, Mode=TwoWay}"  />
                <TextBlock Foreground="Gray" FontSize="12" VerticalAlignment="Center" Margin="20,0,0,0">
                  Which device to use for upscaling with PyTorch. CPU is much slower than GPU and should be avoided unless no GPU is available.
                </TextBlock>
              </StackPanel>

              <StackPanel Orientation="Horizontal" Margin="10,10,0,10">
                <CheckBox IsChecked="{Binding UseFp16}">FP16 Mode</CheckBox>
                <TextBlock Foreground="Gray" FontSize="12" VerticalAlignment="Center" Margin="20,0,0,0">
                  Runs PyTorch upscaling in FP16 mode for less VRAM usage and speedup on RTX GPUs.
                </TextBlock>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Python Environment -->
          <DockPanel Margin="0,10,0,0">
            <TextBlock DockPanel.Dock="Left" FontWeight="Bold" Text="Python Environment"></TextBlock>
          </DockPanel>
          <Border Classes="border">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="10,10,0,10">
                <SelectableTextBlock FontFamily="Consolas" Margin="0,0,5,0" VerticalAlignment="Center" Text="{Binding PythonPath}" />
              </StackPanel>

              <ScrollViewer Margin="0,10,0,0" Background="#111111" Height="450" HorizontalScrollBarVisibility="Auto" Foreground="Gray"  PropertyChanged="ConsoleScrollViewer_PropertyChanged">
                <SelectableTextBlock Margin="20" Text="{Binding PythonPipList}" FontFamily="Consolas" PropertyChanged="ConsoleTextBlock_PropertyChanged" />
              </ScrollViewer>

              <StackPanel Orientation="Horizontal" Margin="10,10,0,10">
                <Button FontWeight="Bold" Background="Red" Content="Reinstall Python Environment" Click="ReinstallBackendClick" />
                <TextBlock Foreground="Gray" Width="400" TextWrapping="WrapWithOverflow" FontSize="12" VerticalAlignment="Center" Margin="20,0,0,0">
                  Reinstall the Python environment. Try this if you are having any problems getting upscales to work. This process may take several minutes.
                </TextBlock>
              </StackPanel>

            </StackPanel>
          </Border>

          <Border Classes="border">
            <ToggleButton DockPanel.Dock="Right" Margin="10,10,0,10" IsChecked="{Binding !RequestShowAppSettings}">
              <StackPanel Orientation="Horizontal">
                <materialIcons:MaterialIcon Kind="ArrowBackCircle" />
                <TextBlock Margin="5,0,0,0">Return</TextBlock>
              </StackPanel>
            </ToggleButton>
          </Border>
        </StackPanel>
      </StackPanel>
      </ScrollViewer>
    </Grid>

    <Grid IsVisible="{Binding IsExtractingBackend}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <StackPanel>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding BackendSetupMainStatus}" />
        <ScrollViewer Margin="0,10,0,0" Background="#111111" Height="450" Width="1200" HorizontalScrollBarVisibility="Auto" Foreground="Gray"  PropertyChanged="ConsoleScrollViewer_PropertyChanged">
          <SelectableTextBlock Margin="20" Text="{Binding BackendSetupSubStatusText}" FontFamily="Consolas" PropertyChanged="ConsoleTextBlock_PropertyChanged" />
        </ScrollViewer>
      </StackPanel>
    </Grid>
  </Grid>

</Window>
